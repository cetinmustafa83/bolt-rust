# Ignore Git and GitHub files
.git
.github/

# Ignore Husky configuration files
.husky/

# Ignore documentation and metadata files
CONTRIBUTING.md
LICENSE
README.md

# Ignore environment examples and sensitive info
# (API keys must be provided at runtime via -e / compose environment, never
# baked into the image)
.env
.env.*
*.local
*.example

# Ignore node modules, logs and cache files
**/*.log
**/node_modules
**/dist
**/build
**/.cache
logs
dist-ssr
.DS_Store

# Rust build artifacts — rebuilt inside the container by `cargo build`
backend-rs/target

# Local caches and assets the image build never reads
.wrangler
docs
assets
electron-dist

# Test / benchmark / verification assets not needed to build or run
tests
e2e-tests
benchmarks
playwright.config.*.ts
verify-*.png

# Electron packaging (the Docker image serves the web SPA via bolt-server)
electron
electron-builder.yml
notarize.cjs
electron-update.yml
